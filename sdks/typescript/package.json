{
  "name": "@pricewatcha/sdk",
  "version": "0.1.5",
  "description": "Official TypeScript client for the Pricewatcha REST API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["pricewatcha", "price-tracking", "api", "sdk"],
  "repository": {
    "type": "git",
    "url": "https://github.com/pricewatcha/pricewatcha-api.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://pricewatcha.com/en/developers",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
